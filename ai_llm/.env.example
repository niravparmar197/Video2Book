# Copy this file to .env and fill in real values. Never commit .env.

# --- Required API keys (see root AGENTS.md LLM provider chain) ---
# NVIDIA NIM (primary, free): https://build.nvidia.com/
NVIDIA_API_KEY=
# Google Gemini (fallback, free): https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# --- Optional: your YouTube login, when YouTube says "Sign in to confirm you're not a bot" ---
# Either a cookies.txt exported from a browser where you are signed in to YouTube
# (most reliable), or a browser name to read cookies from (firefox, edge; Chrome
# often refuses while it is open). Keep this file private: it is your login.
YOUTUBE_COOKIES_FILE=
YOUTUBE_COOKIES_BROWSER=

# --- Eval gate (python -m app.eval) ---
# Empty: use eval/dataset.jsonl. Set: load the examples from this LangSmith dataset.
EVAL_DATASET_NAME=
# true: a drop in the average judge score vs eval/baseline.json blocks (exit code 1).
EVAL_ON_RELEASE=false

# --- Optional: LangSmith tracing (Task 10) ---
LANGSMITH_API_KEY=

# --- Pipeline settings (defaults shown match root AGENTS.md) ---
VIDEO_MODE=stream             # stream | download | captions_only
CHUNK_MINUTES=30
FRAMES_DOWNLOAD_MAX_MINUTES=900  # videos up to this long (15h, covers ~13h) are downloaded (then deleted) for screenshots: ~8x faster than streaming. 0 = always stream
LLM_PARALLEL_CALLS=12          # LLM calls in flight at once; 40 RPM pacing still applies
MAX_SCREENSHOTS_PER_CHUNK=12  # screenshots kept per 30-min chunk, evenly spread. 0 = no limit
SCREENSHOT_REVIEW=true        # the vision model drops person-only frames, re-grabs pop-up frames, captions the rest
VOLUME_HOURS=15               # one PDF up to this many hours of video; longer playlists split into volumes
TRANSCRIPT_SOURCE=auto        # auto | captions | whisper
LLM_PROVIDER=nvidia
LLM_FALLBACK_PROVIDER=gemini  # claude | gemini | nvidia — claude needs a key you don't have yet
VIDEO_GENRE=auto              # auto | lecture | podcast | comedy: study notes, podcast notes or comedy recap
BOOK_ORDER=topic              # topic | video
REVIEW_OUTLINE=true
PASS_SCORE=7
MAX_REFINE_ATTEMPTS=2              # each refine = a full rewrite + re-judge (~80s); 3 is the ceiling
MAX_BOOK_HOURS=30
MAX_BOOK_COST_USD=50
