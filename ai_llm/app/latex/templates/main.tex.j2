\documentclass[11pt]{report}
\usepackage{fontspec}
\usepackage[margin=1in]{geometry}
\usepackage{parskip}
\usepackage{graphicx}
\usepackage{xcolor}
\usepackage{booktabs}
\usepackage[labelfont={bf,color=V2BPrimary}]{caption}
\usepackage{titlesec}
\usepackage{fancyhdr}
\usepackage{imakeidx}
\makeindex

% A single accent color drives every styled element below (chapter/section
% titles, rules, table headers, figure captions, links) so the book reads
% as one deliberately designed document instead of report class defaults.
\definecolor{V2BPrimary}{HTML}{1F3864}
\definecolor{V2BRule}{HTML}{C9A24B}

\titleformat{\chapter}[display]
  {\normalfont\bfseries\color{V2BPrimary}}
  {\Large\chaptertitlename\ \thechapter}
  {4pt}
  {\Huge}
  [\vspace{4pt}{\color{V2BRule}\titlerule[1.2pt]}\vspace{8pt}]
\titlespacing*{\chapter}{0pt}{0pt}{20pt}

\titleformat{\section}
  {\normalfont\Large\bfseries\color{V2BPrimary}}
  {\thesection}
  {8pt}
  {}
\titlespacing*{\section}{0pt}{16pt}{8pt}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\headrule}{\color{V2BRule}\hrule height\headrulewidth}
\fancyhead[C]{\small\textsc{
{% if volume_number %}{{ book_title }} --- Volume {{ volume_number }}{% else %}{{ book_title }}{% endif %}
}}
\fancyfoot[C]{\thepage}
\fancypagestyle{plain}{
  \fancyhf{}
  \fancyfoot[C]{\thepage}
  \renewcommand{\headrulewidth}{0pt}
}

% hyperref last (standard LaTeX practice: it patches other packages'
% commands) -- this is what makes the PDF "interactive": a clickable,
% colored table of contents, index, and PDF bookmark/outline panel in any
% PDF viewer, not just flat printed text.
\usepackage[
  colorlinks=true,
  linkcolor=V2BPrimary,
  citecolor=V2BPrimary,
  urlcolor=V2BPrimary,
  bookmarksnumbered=true,
  pdfauthor={Video2Book},
  pdftitle={ {{- book_title -}} }
]{hyperref}

\title{ {{- book_title -}} }
\author{Video2Book}
\date{}

\begin{document}

\begin{titlepage}
\centering
\vspace*{4cm}
{\color{V2BRule}\rule{0.5\textwidth}{1.2pt}}\\[0.6cm]
{\Huge\bfseries\color{V2BPrimary} {{ book_title }} }\\[0.5cm]
{% if volume_number %}
{\Large\color{V2BPrimary} Volume {{ volume_number }} }\\[0.5cm]
{% endif %}
{\color{V2BRule}\rule{0.5\textwidth}{1.2pt}}\\[2cm]
{\Large Generated by Video2Book}\\[0.3cm]
\vfill
{\large \today}
\end{titlepage}

{% if preface_paragraphs %}
\chapter*{Preface}
\addcontentsline{toc}{chapter}{Preface}
{% for paragraph in preface_paragraphs %}
{{ paragraph }}

{% endfor %}
{% endif %}
\tableofcontents

{% for chapter_id in chapter_ids %}
\input{ {{- chapter_id -}} }
{% endfor %}

{% if has_glossary %}
\input{glossary}
{% endif %}

\printindex

{% if has_topic_index %}
\input{topic_index}
{% endif %}

\end{document}
