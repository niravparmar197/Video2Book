  \fancyfoot[C]{\thepage}
  \renewcommand{\headrulewidth}{0pt}
}

% hyperref last (standard LaTeX practice: it patches other packages'
% commands) -- this is what makes the PDF "interactive": a clickable,
% colored table of contents, index, and PDF bookmark/outline panel in any
% PDF viewer, not just flat printed text.
\usepackage[
  colorlinks=true,
  linkcolor=V2BPrimary,
  citecolor=V2BPrimary,
  urlcolor=V2BPrimary,
  bookmarksnumbered=true,
  pdfauthor={Video2Book},
  pdftitle={ {{- book_title -}} }
]{hyperref}

\title{ {{- book_title -}} }
\author{Video2Book}
\date{}

\begin{document}

