% A small, deliberate palette -- not just one accent -- so the book reads
% as colorful without turning into a rainbow: navy for structure (chapter/
% section titles, links), gold for rules/dividers, teal for the back-matter
% (glossary/topic index) to visually separate it from the main chapters,
% and a light navy tint for highlighted key terms and table headers.
\definecolor{V2BPrimary}{HTML}{1F3864}
\definecolor{V2BRule}{HTML}{C9A24B}
\definecolor{V2BAccent}{HTML}{1B6E6E}
\definecolor{V2BWarn}{HTML}{B3402A}
% Soft tints for callout boxes and a marker-yellow for ==highlighted== phrases.
\definecolor{V2BCalloutGold}{HTML}{FBF3DC}
\definecolor{V2BCalloutTeal}{HTML}{E3F1F1}
\definecolor{V2BCalloutRed}{HTML}{FBE7E3}
\definecolor{V2BHighlight}{HTML}{FFF08A}
% Quote boxes (podcast / comedy books): exact words of a speaker.
\definecolor{V2BQuote}{HTML}{6A4C93}
\definecolor{V2BCalloutPurple}{HTML}{F1ECF7}

% \notecallout{title}{border color}{fill color}{text}: a boxed "Key Point" /
% "Example" / "Watch Out" note. Plain \fcolorbox (no extra package) so it
% adds no compile time; callouts are 1-3 lines, so they never need to break.
{% raw %}
\newcommand{\notecallout}[4]{%
  \par\medskip\noindent
  \fcolorbox{#2}{#3}{%
    \begin{minipage}{\dimexpr\linewidth-2\fboxsep-2\fboxrule\relax}
      {\bfseries\color{#2}#1}\\[2pt]#4
    \end{minipage}}%
  \par\medskip}
{% endraw %}

% Notes-style bullets: tight spacing (keeps notes short) and gold markers.
\setlist[itemize]{itemsep=2pt, topsep=4pt, parsep=0pt, leftmargin=1.5em,
  label={\textcolor{V2BRule}{\textbullet}}}

\titleformat{\chapter}[display]
  {\normalfont\bfseries\color{V2BPrimary}}
  {\Large\chaptertitlename\ \thechapter}
  {4pt}
  {\Huge}
  [\vspace{4pt}{\color{V2BRule}\titlerule[1.2pt]}\vspace{8pt}]
\titlespacing*{\chapter}{0pt}{0pt}{20pt}

\titleformat{\section}
  {\normalfont\Large\bfseries\color{V2BPrimary}}
  {\thesection}
  {8pt}
  {}
\titlespacing*{\section}{0pt}{16pt}{8pt}

\pagestyle{fancy}
