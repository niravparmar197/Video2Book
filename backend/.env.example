DATABASE_URL=postgresql+psycopg://video2book:video2book@localhost:5433/video2book
REDIS_URL=redis://localhost:6379
OUTPUT_ROOT=./output
MAX_CONCURRENT_BOOKS_PER_USER=3

# S3 (S3Mock locally -- see docker-compose.yml). Leave S3_ENDPOINT_URL
# empty in a real deploy so boto3 talks to actual AWS S3.
S3_BUCKET=video2book-books
S3_ENDPOINT_URL=http://localhost:9090
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_REGION=us-east-1
PDF_RETENTION_DAYS=30

# Error tracking -- disabled by default (no SENTRY_DSN = sentry_sdk.init()
# is never called, no network I/O attempted). Set a real DSN to enable.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Worker heartbeat (written to Redis; see GET /health's "worker" field)
WORKER_HEARTBEAT_INTERVAL_SECONDS=15
WORKER_HEARTBEAT_TTL_SECONDS=45

# CORS: the frontend/ origin allowed to call this API from a browser.
FRONTEND_ORIGIN=http://localhost:3000

# Sign-up: with an invite code set, POST /users requires it. Sign-ups per IP
# per hour are capped either way (0 = no cap).
SIGNUP_INVITE_CODE=
SIGNUP_LIMIT_PER_IP_PER_HOUR=5

# API keys older than this are refused until rotated (POST /users/me/api-key). 0 = never expire.
API_KEY_MAX_AGE_DAYS=90

# Daily worker housekeeping: retention (files of books older than
# PDF_RETENTION_DAYS) and a Postgres backup (pg_dump -> S3 backups/, newest
# BACKUPS_TO_KEEP kept). BACKUP_COMMAND= (empty) turns backups off, e.g. on
# RDS with automated backups. pg_dump must be installed where the worker runs.
HOUSEKEEPING_INTERVAL_HOURS=24
BACKUP_COMMAND=pg_dump
BACKUPS_TO_KEEP=14

# LangSmith tracing of every pipeline LLM call, tagged with book_id + phase.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=video2book
