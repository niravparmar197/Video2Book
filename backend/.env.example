DATABASE_URL=postgresql+psycopg://video2book:video2book@localhost:5433/video2book
REDIS_URL=redis://localhost:6379
OUTPUT_ROOT=./output
MAX_CONCURRENT_BOOKS_PER_USER=3

# S3 (S3Mock locally -- see docker-compose.yml). Leave S3_ENDPOINT_URL
# empty in a real deploy so boto3 talks to actual AWS S3.
S3_BUCKET=video2book-books
S3_ENDPOINT_URL=http://localhost:9090
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_REGION=us-east-1
PDF_RETENTION_DAYS=30

# Error tracking -- disabled by default (no SENTRY_DSN = sentry_sdk.init()
# is never called, no network I/O attempted). Set a real DSN to enable.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Worker heartbeat (written to Redis; see GET /health's "worker" field)
WORKER_HEARTBEAT_INTERVAL_SECONDS=15
WORKER_HEARTBEAT_TTL_SECONDS=45
